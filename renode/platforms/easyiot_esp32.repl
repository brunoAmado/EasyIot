// ==============================================================================
// 🧠 EasyIot ESP32 Xtensa Dual-Core Machine Platform for Renode
// Self-contained platform description (Xtensa CPU, RAM, ROM, Flash, GPIO & UART)
// ==============================================================================

// Data RAM (DRAM - Internal SRAM 1 & 2)
// 0x3FFB0000 - 0x3FFDFFFF (192 KB)
dram1: Memory.MappedMemory @ sysbus 0x3FFB0000
    size: 0x30000

// 0x3FFE0000 - 0x3FFFFFFF (128 KB)
dram0: Memory.MappedMemory @ sysbus 0x3FFE0000
    size: 0x20000

// Data Flash (Read-Only Data Cache)
// 0x3F400000 - 0x3F7FFFFF (4 MB)
flash_rodata: Memory.MappedMemory @ sysbus 0x3F400000
    size: 0x400000

// Instruction RAM (IRAM - Internal SRAM 0)
// 0x40000000 - 0x4007FFFF (512 KB)
iram0: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x80000

// Instruction Flash (MMU Mapped Application Flash)
// 0x400D0000 - 0x404CFFFF (4 MB)
flash_inst: Memory.MappedMemory @ sysbus 0x400D0000
    size: 0x400000

// Boot ROM
rom: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x4000000

// Main RAM
ram: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x8000000

// Xtensa Core
cpu: CPU.Xtensa @ sysbus
    cpuType: "sample_controller"
    frequency: 240000000

// Semihosting & Serial Monitor
uartSemihosting: UART.SemihostingUart @ cpu

// ==============================================================================
// ⛲ EasyIot Peripherals (Relays, Fontaine Valves, LEDs)
// ==============================================================================
relay1: Miscellaneous.LED
relay2: Miscellaneous.LED
valve_ring_1: Miscellaneous.LED
valve_ring_2: Miscellaneous.LED
valve_ring_3: Miscellaneous.LED
valve_ring_4: Miscellaneous.LED

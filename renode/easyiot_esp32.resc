# ==============================================================================
# 🧠 EasyIot ESP32 Hardware Emulation Script for Renode
# Executes compiled PlatformIO firmware binary in Xtensa machine
# ==============================================================================

using sysbus

$name?="EasyIot-ESP32"
mach create $name

# Load self-contained EasyIot ESP32 platform
machine LoadPlatformDescription $ORIGIN/platforms/easyiot_esp32.repl

# Display serial monitor terminal
showAnalyzer cpu.uartSemihosting

# Load compiled PlatformIO ELF binary
$bin?=$ORIGIN/../.pio/build/ESP32_DEBUG/firmware.elf

macro reset
"""
    sysbus LoadELF $bin
    # Initialize Xtensa Windowed Register State (simulating Boot ROM setup)
    cpu SetRegister "PS" 0x00040020
    cpu SetRegister "A1" 0x3FFE3E20
    cpu SetRegister "WINDOWBASE" 0
    cpu SetRegister "WINDOWSTART" 1
"""

runMacro $reset

echo "========================================================="
echo "⛲ EasyIot ESP32 Hardware Emulation Running!"
echo "CPU execution started automatically. Press F5 to pause/resume."
echo "========================================================="

start
